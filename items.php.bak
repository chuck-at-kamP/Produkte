<!-- ======================= Bestehende Items auswählen ======================= -->

<form method="post" action="items.php">
<?php if (!empty($items)) { ?>
	<tr>
		<!-- <td class="input"><label>Items: </label></td> -->
	<td colspan=2>
	<select name="select_item" size="10">
		<?php foreach ($items as $item) { ?>
			<option value="<?php echo Helper::e($item['id']); ?>"><?php echo Helper::e($item['updated_at'])." (".Helper::e($item['id']).") ".Helper::e($item['name']); ?></option>
		<?php } ?>
	</select></td></tr>
<?php } ?>

<!-- ====================== Anzeige ========================= -->

	<tr><td colspan="2">
	<table class="data"><tr><th>Key</th><th>Value</th></tr>
		<?php foreach ($items as $item) { ?>
			<tr><td><?php echo Helper::e($item['id']); ?></td>
				<td><?php echo Helper::e($item['updated_at']); ?></td>
				<td><?php echo Helper::e($item['id']); ?></td>
				<td><?php echo Helper::e($item['name']); ?></td>
		<?php } ?>
	</table>
	</td></tr>

<!-- ====================== Buttons ========================= -->
	<tr><td class="button" colspan=2>
		<button type="submit" name="choose" value="play">OK</button>
		<button type="reset" name="choose" value="cancel">Cancel</button>
	</td></tr>
    </form>
</table>

